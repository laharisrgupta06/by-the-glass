# Copy this file to .env and fill in your own values. Never commit .env.
# Only the Node server reads these; they never reach the browser.

# Gemini API key for "Ask our bartender". Leave empty to switch the feature off.
GEMINI_API_KEY=

# Optional: Gemini model id. Defaults to gemini-flash-latest.
GEMINI_MODEL=

# Optional: comma-separated models to try, in order, when the main one is overloaded.
# Defaults to gemini-3.5-flash. Each is checked at startup; retired ones are skipped.
# Set it to none to disable fallbacks.
GEMINI_FALLBACK_MODELS=

# Optional: set to 1 when the server runs behind one proxy or load balancer,
# so rate limits see each visitor's IP instead of the proxy's.
TRUST_PROXY=

# Optional: image models for venue-menu illustrations, tried in order.
# Defaults to gemini-2.5-flash-image,gemini-3.1-flash-image.
GEMINI_IMAGE_MODELS=

# Optional: set to on to allow making venue-menu illustrations (may be billed per image).
# Only requests from this machine are accepted: npm run menu:illustrate -- <drink id>
VENUE_MENU_ILLUSTRATIONS=
